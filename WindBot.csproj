<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>WindBot</RootNamespace>
    <AssemblyName>WindBot</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <OutputType Condition="'$(NativeLib)' != ''">Library</OutputType>
    <PublishAot Condition="'$(NativeLib)' != ''">true</PublishAot>
    <InvariantGlobalization Condition="'$(NativeLib)' != ''">true</InvariantGlobalization>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic-'))">
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
  </PropertyGroup>
  <PropertyGroup Condition="$(RuntimeIdentifier.StartsWith('ios'))">
    <DisableUnsupportedError>true</DisableUnsupportedError>
    <PublishAotUsingRuntimePack>true</PublishAotUsingRuntimePack>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="BotWrapper/**/*.cs;ThirdParty/**/*.cs;artifacts/**/*.cs;target/**/*.cs;rust/**/target/**/*.cs;bin/**/*.cs;obj/**/*.cs" />
    <EmbeddedResource Include="Decks/*.ydk" LogicalName="WindBot.Decks.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Dialogs/*.json" LogicalName="WindBot.Dialogs.%(Filename)%(Extension)" WithCulture="false" />
    <None Update="App.config" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native/windbot.h" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux-bionic-'))">
    <LinkerArg Include="-Wl,--undefined-version" />
  </ItemGroup>
  <Target Name="ExportNativeDependencies" AfterTargets="Publish" Condition="'$(NativeLib)' == 'Static'">
    <MakeDir Directories="$(PublishDir)runtime" />
    <Copy SourceFiles="@(NativeLibrary)" DestinationFolder="$(PublishDir)runtime" SkipUnchangedFiles="true" />
    <WriteLinesToFile File="$(PublishDir)native-dependencies.txt"
                      Lines="@(NativeLibrary->'runtime/%(Filename)%(Extension)');@(SdkNativeLibrary);@(NativeSystemLibrary->'-l%(Identity)');@(NativeFramework->'-framework %(Identity)')"
                      Overwrite="true" />
  </Target>
</Project>
